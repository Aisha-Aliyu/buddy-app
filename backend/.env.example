# Copy to backend/.env for local development. Never commit the real values.
# The Web API key from Firebase (Project settings > General > Your apps). The chat uses it
# to check who is signed in. It's the same value as apiKey in js/firebase.js.
FIREBASE_API_KEY=your-firebase-web-api-key
OPENROUTER_KEY=sk-or-your-key
# Optional: a specific OpenRouter model instead of the free router
# OPENROUTER_MODEL=openrouter/free
